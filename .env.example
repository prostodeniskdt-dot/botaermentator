APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Telegram allows only A-Z, a-z, 0-9, _, - (invalid chars are stripped on startup)
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_CHAT_ID=
ADMIN_USER_IDS=

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# If the DB password contains @/:?#&=+ or spaces, set DATABASE_PASSWORD separately.
DATABASE_PASSWORD=
# Optional PGSSLROOTCERT path for verify-full TLS (Timeweb dashboard download).
DATABASE_SSL_ROOT_CERT=

TIMEWEB_API_BASE_URL=https://api.timeweb.cloud
TIMEWEB_AGENT_1_ID=
TIMEWEB_AGENT_1_TOKEN=
TIMEWEB_AGENT_2_ID=
TIMEWEB_AGENT_2_TOKEN=
TIMEWEB_AGENT_3_ID=
TIMEWEB_AGENT_3_TOKEN=

TIMEWEB_CONNECT_TIMEOUT_SECONDS=5
TIMEWEB_READ_TIMEOUT_SECONDS=120
TIMEWEB_MAX_ATTEMPTS=2
# Prefer requests that explicitly disable reasoning over panel-default native calls.
TIMEWEB_PREFERRED_TRANSPORT=openai

USER_REQUESTS_PER_MINUTE=6
USER_REQUESTS_PER_HOUR=60
USER_REQUESTS_PER_DAY=1000
MAX_CONCURRENT_REQUESTS_PER_USER=1
MAX_QUERY_LENGTH=4000
DUPLICATE_WINDOW_SECONDS=60

SESSION_JUNK_SCORE_PAUSE=10
SESSION_JUNK_SCORE_BLOCK=25
USER_JUNK_SCORE_BLOCK=50

DAILY_AI_BUDGET_RUB=5000
AI_PROCESSING_ENABLED=true

AGENT_1_ESTIMATED_COST_RUB=0.10
AGENT_2_ESTIMATED_COST_RUB=0.10
AGENT_3_ESTIMATED_COST_RUB=1.30
WEB_SEARCH_ESTIMATED_COST_RUB=0.49

STORE_USER_QUESTIONS=true
STORE_BOT_RESPONSES=true

ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_MIN_QUESTION_LEN=10

RICH_MESSAGES_ENABLED=false

# Closed private access and personal dialogue
PRIVATE_ACCESS_ENABLED=true
ACCESS_CONTACT_USERNAME=pprostodenis
NOTIFY_ADMIN_ON_ACCESS_REQUEST=true
STARTING_CREDITS=5
QUICK_MODE_CREDITS=1
DEEP_MODE_CREDITS=5
QUICK_MAX_OUTPUT_TOKENS=600
DEEP_MAX_OUTPUT_TOKENS=5000
DEEP_MAX_CONTINUATIONS=2
PRIVATE_CONTEXT_TURNS=6
PRIVATE_MEMORY_MAX_CHARS=6000
KNOWLEDGE_BASE_VERSION=1
PROMPT_VERSION=7
# Keep local until all three panel prompts and API variants have been verified.
TIMEWEB_PROMPT_SOURCE=local
# Required only for panel mode; this value is an operator declaration, not a panel read.
TIMEWEB_PANEL_PROMPT_SET_VERSION=
# A configured DATABASE_URL always enables durable webhook ingestion, even if this is false.
DURABLE_UPDATE_QUEUE_ENABLED=true
UPDATE_QUEUE_POLL_SECONDS=0.5
UPDATE_QUEUE_MAX_ATTEMPTS=3
UPDATE_QUEUE_STALE_SECONDS=1800
UPDATE_QUEUE_HEARTBEAT_SECONDS=30

# Bounded external calls and independent queue capacity
TIMEWEB_DEADLINE_SECONDS=150
TIMEWEB_MAX_HTTP_REQUESTS=6
UPDATE_QUEUE_CONCURRENCY=2
DELIVERY_QUEUE_CONCURRENCY=2
PARALLEL_CLASSIFIERS_ENABLED=true
PROCESSING_LEASE_SECONDS=300
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10

# Optional explanations and resource recommendations
ANSWER_EXPANSION_CREDITS=4
RECOMMENDATIONS_ENABLED=true
COURSES_URL=https://t.me/ferm2bot
SHOP_URL=https://t.me/AtlasMoldShopBot
